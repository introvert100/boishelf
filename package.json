{
  "name": "boishelf",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "db:test": "tsx --test tests/database.test.ts",
    "validate:render": "node scripts/validate-render.mjs",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "fflate": "0.8.3",
    "lucide-react": "0.577.0",
    "next": "16.3.8",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tus-js-client": "4.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
