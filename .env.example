# Copy to .env.local. Never commit credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# A verified Gmail address. Empty = admin access disabled.
ADMIN_EMAIL=
# Optional bootstrap number; Admin → Payments overrides it after the first save.
# Use only a bKash Personal Retail or Merchant receiving number.
BKASH_RECEIVE_NUMBER=
# Confirm the eligible business account before enabling real checkout.
BKASH_BUSINESS_ACCOUNT_CONFIRMED=false
MANUAL_BKASH_ENABLED=false
# Printed orders remain closed until stock, fees, shipping policy, and a COD courier are ready.
COD_COURIER_CONFIRMED=false
COD_ENABLED=false
MONITOR_TOKEN=
SUPPORT_EMAIL=
