# Copy to .env.local. Never commit credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# A verified Gmail address. Empty = admin access disabled.
ADMIN_EMAIL=
PAYMENT_MODE=sandbox
SSLCOMMERZ_SANDBOX_STORE_ID=
SSLCOMMERZ_SANDBOX_STORE_PASSWORD=
SSLCOMMERZ_LIVE_STORE_ID=
SSLCOMMERZ_LIVE_STORE_PASSWORD=
LIVE_PAYMENTS_ENABLED=false
MERCHANT_APPROVED=false
PAID_HOSTING_CONFIRMED=false
LIVE_PAYMENT_TESTS_CONFIRMED=false
# Owner test access while validating live checkout; requires all other gates.
LIVE_PAYMENT_TEST_MODE=false
MONITOR_TOKEN=
SUPPORT_EMAIL=
